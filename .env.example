# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Pinecone Configuration (if using Pinecone)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_pinecone_environment_here
PINECONE_INDEX_NAME=legal-assistant-index

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/legal_assistant
REDIS_URL=redis://localhost:6379/0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=True

# Scraping Configuration
SCRAPE_DELAY=1
USER_AGENT=LegalAssistant/1.0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Vector Database Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
EMBEDDING_MODEL=text-embedding-ada-002

# Legal Sources URLs
DOF_BASE_URL=https://www.dof.gob.mx/
CONSTITUCION_URL=https://www.diputados.gob.mx/LeyesBiblio/pdf/CPEUM.pdf
ORDEN_JURIDICO_URL=https://www.ordenjuridico.gob.mx/leyes.php