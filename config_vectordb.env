# Archivo de configuración para Base de Datos Vectorial - Lexia
# Copia este archivo como 'config_vectordb.env' y completa tus claves API

# =============================================================================
# PINECONE CONFIGURATION
# =============================================================================
# Obtén tu API key gratuita en: https://app.pinecone.io/
PINECONE_API_KEY=pcsk_7SokNZ_9hBe55G1cjGnWADtXnHePVCB28vytKHQZA5y9SeLGCEzQKzgBZBAVbEdoK9svGS

# Región para tier gratuito (no cambiar)
PINECONE_ENVIRONMENT=us-east-1

# Nombre del índice (puedes cambiarlo)
PINECONE_INDEX_NAME=legal-documents-mx

# =============================================================================
# EMBEDDING MODEL CONFIGURATION
# =============================================================================
# Modelos disponibles:
# - sentence-transformers/all-MiniLM-L6-v2 (gratuito, 384 dim, rápido)
# - sentence-transformers/all-mpnet-base-v2 (gratuito, 768 dim, mejor calidad)
# - intfloat/e5-base-v2 (gratuito, 768 dim, excelente rendimiento)
# - openai-ada-002 (de pago, 1536 dim, requiere OPENAI_API_KEY)

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# =============================================================================
# OPENAI CONFIGURATION (OPCIONAL)
# =============================================================================
# Solo necesario si usas el modelo openai-ada-002
# Obtén tu API key en: https://platform.openai.com/api-keys
# Costo aproximado: $0.0001 por 1K tokens
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# DATA CONFIGURATION
# =============================================================================
# Directorio donde están los documentos extraídos
DATA_DIRECTORY=data/raw

# Límites de almacenamiento por categoría (en MB)
# Total máximo: 2GB para tier gratuito de Pinecone
CPEUM_MAX_SIZE_MB=50
LEYES_FEDERALES_MAX_SIZE_MB=800
REGLAMENTOS_FEDERALES_MAX_SIZE_MB=600
DOF_MAX_SIZE_MB=550

# =============================================================================
# PROCESSING CONFIGURATION
# =============================================================================
# Tamaño máximo de texto para embedding (caracteres)
MAX_TEXT_LENGTH=8000

# Tamaño de lote para inserción en Pinecone
BATCH_SIZE=100

# Número máximo de vectores (aproximado para tier gratuito)
MAX_VECTORS=100000

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=pinecone_vectordb.log